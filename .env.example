# mock is useful before the E3D-side adapter is installed.
E3D_MCP_MODE=mock
# One MCP process owns one version. Set these in each client entry.
# E3D_MCP_VERSION=E3D21
E3D_BRIDGE_URL=http://127.0.0.1:8765
# Optional install root used in status diagnostics.
# E3D_INSTALL_ROOT=C:\Program Files (x86)\AVEVA\Everything3D2.10
# Optional local E3D/PML log; MCP reads this before asking the bridge.
# E3D_LOG_FILE=C:\Path\To\PMLNetTrace.log
E3D_BRIDGE_TIMEOUT=10

# Mutating PML commands stay disabled unless this is explicitly true.
E3D_MCP_ALLOW_COMMANDS=false

# Optional newline-delimited log file exposed by e3d_read_logs.
E3D_LOG_FILE=
